FROM python:3.11-slim

# システムの依存関係をインストール
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libmecab-dev \
    cron \
    mecab \
    mecab-ipadic-utf8 \
    && rm -rf /var/lib/apt/lists/*

# 作業ディレクトリを設定
WORKDIR /app

# Pythonの依存関係をコピーしてインストール
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# アプリケーションのコードをコピー
COPY . .

RUN mkdir -p /app/logs && \
    chmod +x /app/scripts/dev_start.sh

# アプリケーション用のユーザーを作成
RUN useradd -m django && \
    chown -R django:django /app && \
    chmod -R 755 /app

# django ユーザーに切り替え
USER django

# 開発サーバーとスケジューラーを起動
CMD ["bash", "/app/scripts/dev_start.sh"]